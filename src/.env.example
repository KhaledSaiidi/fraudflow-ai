# MinIO / S3
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
MINIO_USERNAME=replace-me
MINIO_PASSWORD=replace-me

# MLflow PostgreSQL
MLFLOW_DB_USER=replace-me
MLFLOW_DB_PASSWORD=replace-me

# Airflow PostgreSQL
AIRFLOW_POSTGRES_USER=replace-me
AIRFLOW_POSTGRES_PASSWORD=replace-me

# Kafka
KAFKA_USERNAME=replace-me
KAFKA_PASSWORD=replace-me

# Airflow credentials and cryptographic secrets
AIRFLOW_ADMIN_USERNAME=replace-me
AIRFLOW_ADMIN_PASSWORD=replace-me
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=replace-me
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AIRFLOW__API_AUTH__JWT_SECRET=replace-me
